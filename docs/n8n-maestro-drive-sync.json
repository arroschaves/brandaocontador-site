{
    "name": "Maestro File Watcher",
    "nodes": [
        {
            "parameters": {
                "pollTimes": {
                    "item": [
                        {
                            "mode": "everyMinute"
                        }
                    ]
                },
                "watchImpl": "polling",
                "fileEvents": [
                    "created"
                ],
                "folderId": "1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP",
                "includeSubfolders": true
            },
            "name": "Google Drive Trigger",
            "type": "n8n-nodes-base.googleDriveTrigger",
            "typeVersion": 1,
            "position": [
                460,
                300
            ],
            "credentials": {
                "googleDriveTriggerApi": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Drive Trigger account"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://www.brandaocontador.com.br/api/maestro/webhook",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "event",
                            "value": "file_created"
                        },
                        {
                            "name": "file_name",
                            "value": "={{$json[\"name\"]}}"
                        },
                        {
                            "name": "folder_id",
                            "value": "={{$json[\"parents\"][0]}}"
                        },
                        {
                            "name": "drive_url",
                            "value": "={{$json[\"webViewLink\"]}}"
                        },
                        {
                            "name": "mime_type",
                            "value": "={{$json[\"mimeType\"]}}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Notify Maestro API",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                680,
                300
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "YOUR_MAESTRO_AUTH_ID",
                    "name": "Maestro API Key (Header)"
                }
            }
        }
    ],
    "connections": {
        "Google Drive Trigger": {
            "main": [
                [
                    {
                        "node": "Notify Maestro API",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}