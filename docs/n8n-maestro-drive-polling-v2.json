{
    "name": "Maestro Drive Sensor v2 (Recursive Polling)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutes": 3
                        }
                    ]
                }
            },
            "name": "Schedule (3min)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                300,
                300
            ],
            "id": "schedule-trigger"
        },
        {
            "parameters": {
                "operation": "list",
                "useQuery": true,
                "query": "='1iiolcacOKwBKxM7Y0vgevT1YKwjTc1FP' in parents and trashed = false and modifiedTime > '\" + $now.minus({minutes: 3}).toISO() + \"'",
                "options": {
                    "fields": [
                        "id",
                        "name",
                        "parents",
                        "mimeType",
                        "webViewLink",
                        "createdTime",
                        "modifiedTime"
                    ],
                    "includeItemsFromAllDrives": true,
                    "supportsAllDrives": true,
                    "pageSize": 100,
                    "corpora": "allDrives"
                }
            },
            "name": "Google Drive - Root Level",
            "type": "n8n-nodes-base.googleDrive",
            "typeVersion": 2,
            "position": [
                540,
                300
            ],
            "credentials": {
                "googleDriveOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Drive account"
                }
            },
            "id": "google-drive-root"
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{$json[\"mimeType\"]}}",
                            "operation": "notEqual",
                            "value2": "application/vnd.google-apps.folder"
                        }
                    ]
                }
            },
            "name": "Filter Files Only",
            "type": "n8n-nodes-base.filter",
            "typeVersion": 1,
            "position": [
                740,
                300
            ],
            "id": "filter-files"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://www.brandaocontador.com.br/api/maestro/webhook",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "event",
                            "value": "file_created"
                        },
                        {
                            "name": "file_name",
                            "value": "={{$json[\"name\"]}}"
                        },
                        {
                            "name": "folder_id",
                            "value": "={{$json[\"parents\"] ? $json[\"parents\"][0] : ''}}"
                        },
                        {
                            "name": "drive_url",
                            "value": "={{$json[\"webViewLink\"]}}"
                        },
                        {
                            "name": "mime_type",
                            "value": "={{$json[\"mimeType\"]}}"
                        }
                    ]
                },
                "options": {
                    "timeout": 10000
                }
            },
            "name": "POST to Maestro Webhook",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                960,
                300
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "YOUR_MAESTRO_AUTH_ID",
                    "name": "Maestro API Key (Header)"
                }
            },
            "id": "http-request-webhook"
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": true,
                            "value2": true
                        }
                    ]
                }
            },
            "name": "No Files Found",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                740,
                500
            ],
            "id": "no-op-empty"
        }
    ],
    "connections": {
        "Schedule (3min)": {
            "main": [
                [
                    {
                        "node": "Google Drive - Root Level",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Drive - Root Level": {
            "main": [
                [
                    {
                        "node": "Filter Files Only",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filter Files Only": {
            "main": [
                [
                    {
                        "node": "POST to Maestro Webhook",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "No Files Found",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "meta": {
        "templateId": "maestro-drive-v2",
        "templateCredsSetupCompleted": false
    }
}