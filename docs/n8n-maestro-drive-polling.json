{
    "name": "Maestro Drive Sensor (Polling)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutes": 2
                        }
                    ]
                }
            },
            "name": "Schedule",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.1,
            "position": [
                380,
                240
            ],
            "id": "schedule-trigger"
        },
        {
            "parameters": {
                "operation": "list",
                "useQuery": true,
                "query": "='1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP' in parents and trashed = false and createdTime > '\" + $now.minus({minutes: 2}).toISO() + \"'",
                "options": {
                    "fields": [
                        "id",
                        "name",
                        "parents",
                        "mimeType",
                        "webViewLink"
                    ]
                }
            },
            "name": "Google Drive",
            "type": "n8n-nodes-base.googleDrive",
            "typeVersion": 2,
            "position": [
                600,
                240
            ],
            "credentials": {
                "googleDriveOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Drive account"
                }
            },
            "id": "google-drive-list"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://www.brandaocontador.com.br/api/maestro/webhook",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "event",
                            "value": "file_created"
                        },
                        {
                            "name": "file_name",
                            "value": "={{$json[\"name\"]}}"
                        },
                        {
                            "name": "folder_id",
                            "value": "={{$json[\"parents\"][0]}}"
                        },
                        {
                            "name": "drive_url",
                            "value": "={{$json[\"webViewLink\"]}}"
                        },
                        {
                            "name": "mime_type",
                            "value": "={{$json[\"mimeType\"]}}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Notify Maestro API",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                820,
                240
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "YOUR_MAESTRO_AUTH_ID",
                    "name": "Maestro API Key (Header)"
                }
            },
            "id": "http-request-webhook"
        }
    ],
    "connections": {
        "Schedule": {
            "main": [
                [
                    {
                        "node": "Google Drive",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Drive": {
            "main": [
                [
                    {
                        "node": "Notify Maestro API",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}