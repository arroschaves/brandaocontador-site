{
    "name": "Upload Brandao - SMART COMPLETO",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "upload-brandao",
                "options": {},
                "responseMode": "onReceived"
            },
            "id": "1",
            "name": "Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "webhookId": "upload-brandao-smart"
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $headers['x-api-key'] }}",
                            "value2": "BRANDAO_SYNC_2026_SECURE_KEY"
                        }
                    ]
                }
            },
            "id": "2",
            "name": "Check API Key",
            "type": "n8n-nodes-base.if",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Extrai CNPJ/CPF do nome do arquivo (ex: '12.345.678/0001-00 - Nota.pdf')\nconst filename = $binary.file.fileName;\nconst docMatch = filename.match(/\\d{2,3}\\.?\\d{3}\\.?\\d{3}\\/?\\d{4}-?\\d{2}|\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}/);\nconst timestamp = new Date();\n\nreturn {\n  json: {\n    filename: filename,\n    detected_doc: docMatch ? docMatch[0].replace(/\\D/g, '') : null,\n    year: timestamp.getFullYear().toString(),\n    month_num: (timestamp.getMonth() + 1).toString().padStart(2, '0')\n  },\n  binary: $binary\n};"
            },
            "id": "3",
            "name": "Scan Filename",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "operation": "getAll",
                "tableId": "clientes",
                "filters": {
                    "conditions": [
                        {
                            "keyName": "cnpj_cpf",
                            "condition": "like",
                            "keyValue": "={{ '%' + $json.detected_doc + '%' }}"
                        }
                    ]
                }
            },
            "id": "4",
            "name": "Find Client",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "tvymDvbKT2vFr50N",
                    "name": "Supabase account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const client = $node['Find Client']?.json?.[0] || { id: 'unknown', nome: 'DESCONHECIDO', drive_folder_id: '1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP' };\nconst meta = $node['Scan Filename'].json;\n\nreturn {\n  json: {\n    client_id: client.id,\n    client_name: client.nome,\n    root_folder_id: client.drive_folder_id,\n    year: meta.year,\n    month_num: meta.month_num,\n    filename: meta.filename\n  },\n  binary: $node['Scan Filename'].binary\n};"
            },
            "id": "5",
            "name": "Prepare Folders",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                1050,
                300
            ]
        },
        {
            "parameters": {
                "resource": "file",
                "operation": "upload",
                "name": "={{ $json.filename }}",
                "inputDataFieldName": "file",
                "folderId": {
                    "__rl": true,
                    "value": "={{ $json.root_folder_id }}",
                    "mode": "id"
                }
            },
            "id": "6",
            "name": "Upload to Root (Simple)",
            "type": "n8n-nodes-base.googleDrive",
            "typeVersion": 3,
            "position": [
                1250,
                300
            ],
            "credentials": {
                "googleDriveOAuth2Api": {
                    "id": "b4mywljyK2WCSlSG",
                    "name": "Google Drive account"
                }
            }
        }
    ],
    "connections": {
        "Webhook": {
            "main": [
                [
                    {
                        "node": "Check API Key",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Check API Key": {
            "main": [
                [
                    {
                        "node": "Scan Filename",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Scan Filename": {
            "main": [
                [
                    {
                        "node": "Find Client",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Find Client": {
            "main": [
                [
                    {
                        "node": "Prepare Folders",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare Folders": {
            "main": [
                [
                    {
                        "node": "Upload to Root (Simple)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "active": false,
    "settings": {
        "executionOrder": "v1"
    }
}