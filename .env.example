# ===========================================
# BRANDÃO CONTABILIDADE - VARIÁVEIS DE AMBIENTE
# ===========================================

# ===== CONFIGURAÇÕES GERAIS =====
# URL base do site (usado para SEO e links absolutos)
NEXT_PUBLIC_SITE_URL=https://brandaocontador.com.br

# Ambiente de execução (development, production, test)
NODE_ENV=production

# ===== CONFIGURAÇÕES DE CONTATO =====
# Informações de contato da empresa
NEXT_PUBLIC_COMPANY_NAME="Brandão Contabilidade"
NEXT_PUBLIC_COMPANY_EMAIL=contato@brandaocontador.com.br
NEXT_PUBLIC_COMPANY_PHONE=(67) 3272-1356
NEXT_PUBLIC_COMPANY_WHATSAPP=5567996011356
NEXT_PUBLIC_COMPANY_ADDRESS="Rua Exemplo, 123, Centro - Sidrolândia/MS"
NEXT_PUBLIC_COMPANY_CEP=79170-000

# ===== CONFIGURAÇÕES DE EMAIL =====
# Configurações SMTP para envio de emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato@brandaocontador.com.br
SMTP_PASSWORD=sua_senha_de_app_aqui
SMTP_FROM=contato@brandaocontador.com.br

# ===== CONFIGURAÇÕES DE BANCO DE DADOS =====
# URL de conexão com o banco de dados (PostgreSQL/MySQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/brandao_contabilidade

# ===== CONFIGURAÇÕES DE AUTENTICAÇÃO =====
# Chave secreta para JWT (gere uma chave forte)
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_com_pelo_menos_32_caracteres

# Chave para criptografia de sessões
NEXTAUTH_SECRET=sua_chave_nextauth_secreta_aqui
NEXTAUTH_URL=https://brandaocontador.com.br

# Chave para o Vault (Cofre Maestro) - AES-256-GCM
# Gere uma chave de 32 bytes: `openssl rand -hex 32`
ENCRYPTION_KEY=sua_chave_de_criptografia_de_32_bytes_aqui

# ===== CONFIGURAÇÕES DE STORAGE =====
# AWS S3 para armazenamento de documentos
AWS_ACCESS_KEY_ID=sua_access_key_aws
AWS_SECRET_ACCESS_KEY=sua_secret_key_aws
AWS_REGION=us-east-1
AWS_S3_BUCKET=brandao-contabilidade-docs

# ===== CONFIGURAÇÕES DE ANALYTICS =====
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===== CONFIGURAÇÕES DE MONITORAMENTO =====
# Sentry para monitoramento de erros
NEXT_PUBLIC_SENTRY_DSN=https://sua_dsn_sentry_aqui

# ===== CONFIGURAÇÕES DE PAGAMENTO =====
# Stripe para pagamentos online (futuro)
STRIPE_PUBLIC_KEY=pk_test_sua_chave_publica_stripe
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_webhook_stripe

# ===== CONFIGURAÇÕES DE API EXTERNA =====
# API dos Correios para CEP
CORREIOS_API_KEY=sua_chave_api_correios

# API da Receita Federal
RECEITA_FEDERAL_API_KEY=sua_chave_api_receita

# ===== CONFIGURAÇÕES DE DESENVOLVIMENTO =====
# Apenas para desenvolvimento local
NEXT_PUBLIC_DEV_MODE=false

# ===== CONFIGURAÇÕES DE CACHE =====
# Redis para cache (opcional)
REDIS_URL=redis://localhost:6379

# ===== CONFIGURAÇÕES DE LOGS =====
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# ===== CONFIGURAÇÕES DE RATE LIMITING =====
# Limite de requisições por IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ===== CONFIGURAÇÕES DO GOOGLE DRIVE =====
# Credenciais da Service Account do Google Drive (JSON completo)
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sua-service-account@seu-projeto.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ID da pasta raiz CRM no Google Drive
# ⚠️ OBRIGATÓRIO - ID correto: 1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP
GOOGLE_DRIVE_ROOT_FOLDER_ID=1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP

# ===== SUPABASE =====
# Obtenha em: https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ===== GEMINI AI (Google) =====
# ⚠️ OBRIGATÓRIO para o BRAIN MAESTRO e classificação fiscal
# Obtenha GRATUITAMENTE em: https://aistudio.google.com/apikey
# SDK: @google/genai (NÃO usar @google/generative-ai - DEPRECATED)
# Modelos ativos: gemini-3-flash-preview | gemini-3-pro-preview
GEMINI_API_KEY=sua_chave_gemini_aqui

# ===== N8N WEBHOOKS =====
# URLs dos webhooks N8N (não hardcodar nos workflows)
N8N_WEBHOOK_BASE_URL=https://webhook.brandaocontador.com.br
N8N_WEBHOOK_CADASTRO=https://webhook.brandaocontador.com.br/webhook/cadastro-cliente
N8N_WEBHOOK_AUTOAUTOMACAO=https://webhook.brandaocontador.com.br/webhook/3232dacd-f6a4-40ed-9b57-5a22045de998

# ===== EVOLUTION API (WhatsApp) =====
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_chave_evolution_aqui
EVOLUTION_INSTANCE=nome-da-instancia

# ===========================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# ===========================================
#
# 1. Copie este arquivo para .env.local (desenvolvimento) ou .env (produção)
# 2. Substitua todos os valores de exemplo pelos valores reais
# 3. NUNCA commite o arquivo .env com valores reais
# 4. Para produção, configure as variáveis no painel da Vercel
# 5. Para desenvolvimento, use .env.local
#
# SEGURANÇA:
# - Use senhas fortes para todas as chaves
# - Mantenha as chaves de API seguras
# - Rotacione as chaves periodicamente
# - Use diferentes chaves para dev/prod
#
# ===========================================