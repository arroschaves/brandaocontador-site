# ============================================
# Brandão Contador - Variáveis de Produção
# ============================================
# Configure estas variáveis no painel do Vercel
# NUNCA adicione valores reais a este arquivo!
# ============================================

# --------------------------------------------
# CONFIGURAÇÕES PÚBLICAS (Frontend)
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ycgwmwmcyxwflkaehwds.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --------------------------------------------
# EMAIL/SMTP (Backend only - não use NEXT_PUBLIC_)
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# --------------------------------------------
# APIs EXTERNAS
# --------------------------------------------
# Google Gemini
GEMINI_API_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.brandaocontador.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=escritorioatendimento

# --------------------------------------------
# BANCO DE DADOS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.ycgwmwmcyxwflkaehwds.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --------------------------------------------
# EMAIL ZOHO (gerenciar separadamente)
# --------------------------------------------
ZOHO_PASS_RH=
ZOHO_PASS_ADM=
ZOHO_PASS_CJ=

# --------------------------------------------
# N8N / Automação
# --------------------------------------------
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Analytics (Opcional)
# --------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# --------------------------------------------
# Google Search Console
# --------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --------------------------------------------
# Desenvolvimento
# --------------------------------------------
NODE_ENV=production