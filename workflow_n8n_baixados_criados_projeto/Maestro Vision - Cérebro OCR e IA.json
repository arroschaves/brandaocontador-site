{
    "name": "Maestro Vision - Cérebro OCR e IA",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "maestro-vision-trigger",
                "options": {}
            },
            "id": "webhook-trigger",
            "name": "Webhook Maestro",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                100,
                300
            ],
            "webhookId": "maestro-vision-webhook"
        },
        {
            "parameters": {
                "operation": "download",
                "fileId": "={{ $json.body.file_id }}",
                "options": {}
            },
            "id": "download-file",
            "name": "Download PDF/Image",
            "type": "n8n-nodes-base.googleDrive",
            "typeVersion": 3,
            "position": [
                300,
                300
            ],
            "credentials": {
                "googleDriveOAuth2Api": {
                    "id": "b4mywljyK2WCSlSG",
                    "name": "Google Drive account"
                }
            }
        },
        {
            "parameters": {
                "model": "gemini-1.5-flash",
                "options": {
                    "temperature": 0
                }
            },
            "id": "gemini-model",
            "name": "Google Gemini Vision",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                450,
                500
            ],
            "credentials": {
                "googlePalmApi": {
                    "id": "7GUTW2bFdnyNqit9",
                    "name": "Google Gemini(PaLM) Api account"
                }
            }
        },
        {
            "parameters": {
                "promptType": "define",
                "text": " Você é o BRAIN MAESTRO da Brandão Contabilidade.\n Analise o nome do arquivo e o conteúdo visual do documento.\n ARQUIVO: {{ $node[\"Webhook Maestro\"].json.body.file_name }}\n\n OBJETIVO: Extrair metadados e classificar segundo o ENUM contábil.\n\n REGRAS:\n 1. Identificar o TIPO (DAS, FGTS, DARF, ALVARA_FUNCIONAMENTO, etc).\n 2. Extrair DATA DE VENCIMENTO (YYYY-MM-DD).\n 3. Extrair VALOR (Número).\n 4. Extrair COMPETÊNCIA (YYYY-MM-01).\n\n SAÍDA JSON PURA:\n {\n   \"tipo\": \"DAS\",\n   \"vencimento\": \"2026-03-20\",\n   \"valor\": 1500.50,\n   \"competencia\": \"2026-02-01\",\n   \"metadata\": { \"info_extra\": \"...\" }\n }",
                "options": {
                    "systemMessage": "Você é um especialista em documentos contábeis brasileiros. Saída deve ser apenas JSON válido."
                }
            },
            "id": "ia-vision-agent",
            "name": "AI Vision Maestro",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1.6,
            "position": [
                550,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const raw = $json.output.replace(/```json|```/g, '').trim();\nconst data = JSON.parse(raw);\nconst body = $node[\"Webhook Maestro\"].json.body;\n\nreturn {\n  drive_file_id: body.file_id,\n  empresa_id: body.empresa_id,\n  tipo: data.tipo,\n  vencimento: data.vencimento,\n  valor: data.valor,\n  competencia: data.competencia,\n  nome_arquivo: body.file_name,\n  metadata_ia: data\n};"
            },
            "id": "format-to-supabase",
            "name": "Formatar para API",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://www.brandaocontador.com.br/api/maestro/process",
                "sendBody": true,
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "drive_file_id",
                            "value": "={{ $json.drive_file_id }}"
                        },
                        {
                            "name": "empresa_id",
                            "value": "={{ $json.empresa_id }}"
                        },
                        {
                            "name": "tipo",
                            "value": "={{ $json.tipo }}"
                        },
                        {
                            "name": "competencia",
                            "value": "={{ $json.competencia }}"
                        },
                        {
                            "name": "vencimento",
                            "value": "={{ $json.vencimento }}"
                        },
                        {
                            "name": "valor",
                            "value": "={{ $json.valor }}"
                        },
                        {
                            "name": "metadata_ia",
                            "value": "={{ $json.metadata_ia }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "send-to-supabase",
            "name": "Enviar para Supabase",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1050,
                300
            ]
        }
    ],
    "connections": {
        "Webhook Maestro": {
            "main": [
                [
                    {
                        "node": "Download PDF/Image",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Download PDF/Image": {
            "main": [
                [
                    {
                        "node": "AI Vision Maestro",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Google Gemini Vision": {
            "ai_languageModel": [
                [
                    {
                        "node": "AI Vision Maestro",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ]
            ]
        },
        "AI Vision Maestro": {
            "main": [
                [
                    {
                        "node": "Formatar para API",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Formatar para API": {
            "main": [
                [
                    {
                        "node": "Enviar para Supabase",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}