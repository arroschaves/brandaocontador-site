    },
    {
      "parameters": {
        "jsCode": "// Extrai CNPJ/CPF do nome do arquivo (ex: '12.345.678/0001-00 - Nota.pdf')\nconst filename = $binary.file.fileName;\nconst docMatch = filename.match(/\\d{2,3}\\.?\\d{3}\\.?\\d{3}\\/?\\d{4}-?\\d{2}|\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}/);\nconst timestamp = new Date();\n\nreturn {\n  json: {\n    filename: filename,\n    detected_doc: docMatch ? docMatch[0].replace(/\\D/g, '') : null,\n    year: timestamp.getFullYear().toString(),\n    month_num: (timestamp.getMonth() + 1).toString().padStart(2, '0')\n  },\n  binary: $binary\n};"
      },
      "id": "4abee092-ac1f-4066-bc51-af384945a472",
      "name": "Scan Filename",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        9472,
        2464
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "core.empresas",
        "filters": {
          "conditions": [
            {
              "keyName": "cnpj_cpf",
              "condition": "like",
              "keyValue": "={{ '%' + $json.detected_doc + '%' }}"
            }
          ]
        }
      },
      "id": "8671baf2-45e1-4a7e-8966-012365c5d9db",
      "name": "Find Client",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        9648,
        2464
      ],
      "credentials": {
        "supabaseApi": {
          "id": "tvymDvbKT2vFr50N",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const client = $node['Find Client']?.json?.[0] || { id: 'unknown', nome: 'DESCONHECIDO', drive_folder_id: '1iioIcacOKwBKxM7Y0vgevT1YKwjTc1FP' };\nconst meta = $node['Scan Filename'].json;\n\nreturn {\n  json: {\n    client_id: client.id,\n    client_name: client.nome,\n    root_folder_id: client.drive_folder_id,\n    year: meta.year,\n    month_num: meta.month_num,\n    filename: meta.filename\n  },\n  binary: $node['Scan Filename'].binary\n};"
      },
      "id": "387968ec-8669-43ce-8bd7-dfacc6ab2c6d",
      "name": "Prepare Folders",
      "type": "n8n-nodes-base.code",
