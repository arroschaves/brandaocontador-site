    {
      "parameters": {
        "jsCode": "const feriados = ['2026-01-01', '2026-02-16', '2026-02-17', '2026-04-03', '2026-04-21', '2026-05-01', '2026-06-04', '2026-09-07', '2026-10-12', '2026-11-02', '2026-11-15', '2026-11-20', '2026-12-25'];\nconst agora = $now.setZone('America/Campo_Grande');\nconst hoje = agora.toFormat('yyyy-MM-dd');\nconst isFeriado = feriados.includes(hoje);\nconst isFimDeSemana = agora.weekday >= 6;\nconst isAberto = !isFeriado && !isFimDeSemana && agora.hour >= 8 && agora.hour < 18;\nreturn { escritorio_aberto: isAberto, motivo: isFeriado ? 'feriado' : (isFimDeSemana ? 'fim de semana' : 'fora do horário'), hora_atual: agora.toFormat('HH:mm') };"
      },
      "id": "b6120596-a835-401f-bf68-a891b263e0d3",
      "name": "Check Expediente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2736,
        -1584
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=CLIENTE: {{ $node[\"Busca Cliente\"].json.nome || 'Amigo(a)' }}\nCNPJ: {{ $node[\"Busca Cliente\"].json.cnpj_cpf || 'Não informado' }}\nABERTO AGORA: {{ $json.escritorio_aberto }}\nMOTIVO FECHADO: {{ $json.motivo }}\nMENSAGEM: {{ $node[\"Dados Brutos\"].json.message }}",
        "options": {
          "systemMessage": "=# PERFIL\nVocê é o assistente da Brandão Contabilidade.\n\n# REGRAS\n- Se o escritório estiver fechado, informe o motivo e diga que retornaremos no próximo dia útil às 08:00.\n- Use sempre o nome do cliente.\n- SAÍDA JSON PURA: {\"is_pedido\": true, \"categoria\": \"...\", \"prioridade\": \"NORMAL\", \"resposta\": \"...\"}"
        }
      },
      "id": "6592a2aa-0320-4e67-b804-e99245d32aac",
      "name": "IA Classificador",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        2944,
        -1584
      ]
    },
    {
      "parameters": {
        "jsCode": "let output = {};\ntry {\n  const raw = $node[\"IA Classificador\"].json.output.replace(/```json|```/g, \"\").trim();\n  output = JSON.parse(raw);\n} catch (e) {\n  output = { resposta: $node[\"IA Classificador\"].json.output, categoria: \"Geral\", prioridade: \"NORMAL\" };\n}\n// Ajuste de prioridade para MAIÚSCULAS (evita erro de constraint no Supabase)\nlet p = String(output.prioridade).toUpperCase();\noutput.prioridade = p.includes(\"ALTA\") ? \"ALTA\" : (p.includes(\"BAIXA\") ? \"BAIXA\" : \"NORMAL\");\nreturn output;"
      },
