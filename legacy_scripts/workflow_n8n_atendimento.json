                        },
                        {
                            "name": "text",
                            "value": "={{ $json.resposta_automatica }}\\n\\n_Mensagem automática. Se precisar de mais ajuda, nossa equipe responderá em breve._"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Enviar Resposta Automática",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
